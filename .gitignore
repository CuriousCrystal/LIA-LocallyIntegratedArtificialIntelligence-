# Claude Code's own local state -- settings.json/settings.local.json can end
# up recording literal command strings (including secrets passed as CLI args)
# in their permission-allowlist entries. Never publish this folder.
.claude/

# Lia's memory -- personal conversation history, not project source.
*.db

# Build output -- large, regenerable, platform-specific.
build/
dist/
__pycache__/
*.pyc
*.spec

# Logs.
*.log
cloud_fallback_log.jsonl

# Downloadable models -- large binaries, re-fetched via LIA/models/README.md
# and LIA/voices/README.md rather than committed.
LIA/models/*.onnx
# The voice files were named in the comment above but never actually matched,
# so the three Piper voices (~60MB each) went in with the first commit and are
# in the history already -- this rule cannot pull them back out, it only stops
# the next one being added. GitHub warns at 50MB and refuses at 100MB, so a
# fourth voice is worth not committing. The .json beside each one is small and
# stays either way.
LIA/voices/*.onnx

# Anything you've handed her. Documents you drop in the library are yours (and
# often someone else's copyright); music likewise; her notes are personal.
# Only the READMEs explaining what the folders are for belong in the repo.
LIA/library/*
!LIA/library/README.md
LIA/music/*
!LIA/music/README.md
LIA/notes/*
!LIA/notes/README.md

# Desktop avatar art -- yours to add, and often someone else's character.
# Only the README and the vendored three.js/three-vrm viewer belong in the repo.
LIA/vrm/*
!LIA/vrm/README.md
!LIA/vrm/vendor/
# Where the avatar's dragged position is remembered.
vrm_pos.json

# API keys. Put yours in LIA/.env -- never in config.py, which is committed.
.env
.env.*
!.env.example
!LIA/.env.example

# plain-text conversions of library documents, regenerated on demand
extracted/
# what she took each request to mean -- your usage, not code
intent_log.jsonl
# database backups
*.bak-*

# Virtual environment. Not committed for the usual reasons -- it is large,
# platform-specific, and rebuildable from requirements.txt.
.venv/
venv/

# OpenVINO model files, downloaded rather than committed -- same reasoning as
# the .onnx rules above, and the same fetch instructions in config.py beside
# WHISPER_OV_MODEL. ~154MB for base.en, past GitHub's 100MB per-file refusal
# once the weights are in one .bin.
LIA/models/openvino/

# OpenVINO's compiled-model cache. Rebuilt automatically on first run, and
# specific to this exact CPU, driver version and OpenVINO build -- so it is
# not merely large (~360MB), it is actively wrong on any other machine.
ov_cache/

# Not project source -- local tool state and an ad-hoc screenshot that ended
# up in the repo root.
.freebuff/
fix1_window.png
