# Copy this file to LIA/.env and fill in your key. LIA/.env is gitignored.
# config.py loads it automatically (needs python-dotenv, in requirements.txt).
# A real OS environment variable, if set, still wins over anything here.

# Option 1 (default): Gemini -- free tier from Google AI Studio, no card.
# Get a key at https://aistudio.google.com/apikey
# She chats through Gemini's OpenAI-compatible endpoint and transcribes your
# voice with Gemini's native audio API. Set this and nothing else.
GEMINI_API_KEY=

# Option 2: Groq -- chat and Whisper transcription in one place.
# Get a key at https://console.groq.com/keys
# GROQ_API_KEY=gsk-...

# Option 3: any other OpenAI-compatible endpoint (OpenAI, an Azure gateway, a
# local server). Set the key AND the base URL; used when neither key above is.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
