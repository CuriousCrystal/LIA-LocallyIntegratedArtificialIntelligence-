# Copy this file to LIA/.env and fill in your key. LIA/.env is gitignored.
# config.py loads it automatically (needs python-dotenv, in requirements.txt).
# A real OS environment variable, if set, still wins over anything here.

# Required. The default provider is Groq -- free, no card.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Alternative provider: point the base URL at OpenAI (or an Azure gateway, a
# proxy, a local OpenAI-compatible server) and put a matching key here instead.
# The two are tried in order -- GROQ_API_KEY first, then OPENAI_API_KEY -- so
# set only the one you want. Chat and speech-to-text both go here.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
