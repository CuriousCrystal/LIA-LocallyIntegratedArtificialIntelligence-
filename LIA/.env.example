# Copy this file to LIA/.env if you want to override a default. LIA/.env is
# gitignored. config.py loads it automatically (needs python-dotenv, in
# requirements.txt). A real OS environment variable, if set, still wins over
# anything here.

# Chat runs on a local model through Ollama -- no key needed. Install Ollama
# (ollama.com), leave it running, and `ollama pull phi3:mini` (or whichever
# model you set below). Speech-to-text is local faster-whisper, which
# downloads its own model automatically on first use.

# Only needed if Ollama isn't on its default localhost port.
# OLLAMA_BASE_URL=http://localhost:11434

# Only needed to use a different pulled model than the default (phi3:mini).
# LOCAL_CHAT_MODEL=llama3.2:3b

# Only needed to change faster-whisper's model size (tiny/base/small/medium/large-v3).
# LOCAL_WHISPER_MODEL=base
